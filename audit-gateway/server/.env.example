# ==========================================================
# audit-gateway 环境变量示例
# 复制为 .env.dev（开发）或 .env.prod（生产）后填写实际值
# 这两个文件已在 .gitignore 中，切勿提交
# ==========================================================

ENVIRONMENT=dev
LOG_LEVEL=INFO
BASE_URL=localhost
# 仅用于日志与 OpenAPI 标题，不参与路由
APP_NAME=audit-gateway

# 监听地址。改端口要同步前端 client/vite.config.mts 的 GATEWAY_ORIGIN
HOST=localhost
PORT=7899

# ---- MySQL ----
# 直连本地 MySQL；库需要先手工建好：
#   CREATE DATABASE audit_gateway DEFAULT CHARACTER SET utf8mb4;
MYSQL_URL=mysql+aiomysql://用户名:密码@127.0.0.1:3306/audit_gateway?charset=utf8mb4
DB_ECHO=false

# 连接池。默认值够小规模用；并发上来之后先调这里再考虑加机器。
# POOL_RECYCLE 要**小于** MySQL 的 wait_timeout（默认 28800 秒），否则连接会在
# 池子里被服务端悄悄掐掉，下次借出去时才炸 —— 现象是零星的「连接已断开」。
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=60
POOL_RECYCLE=900

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
# 走 unix socket 时填这里，填了就优先于 REDIS_URL。同机部署可以省掉一层 TCP。
REDIS_SOCK=

# ---- JWT ----
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# 设备 API Key 闲置失效天数（超过这么多天没有任何 /v1 调用即失效），0 = 关闭。
# 生效值不会低于 refresh token 有效期 + 1 天，否则会踢掉仍在续期的客户端。
API_KEY_IDLE_DAYS=30
# 闲置 Key 自动吊销的巡检间隔（秒），0 = 不巡检
API_KEY_IDLE_SWEEP_INTERVAL_SECONDS=3600
# 对外开放接口（/open/v1，如 OSS 成员搜索）每个接入应用每分钟调用上限
OPEN_API_RATE_LIMIT_PER_MINUTE=120
ALGORITHM=HS256

# ---- 钉钉 SSO ----
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_REDIRECT_URI=

# ---- 企业统一登录 OIDC（留空时新协议入口返回 503）----
# 正式环境使用独立 HTTPS 发admin域名；私钥路径指向服务端密钥存储，不进仓库。
SSO_ISSUER=
SSO_ORG_ID=
SSO_SIGNING_PRIVATE_KEY=
SSO_SIGNING_KEY_ID=
# 轮换期可选：目录内以旧 kid 命名的 .pem 公钥。
SSO_PUBLIC_KEY_ARCHIVE_DIR=

# 网站产物文件私有持久卷（不可位于 static、client/dist 或公开 Web 根目录）
ARTIFACT_STORAGE_PATH=
# ---- 可逆加密密钥（生产缺失会拒绝启动）----
# 必须是 32 字节的 urlsafe base64（44 位、以 = 结尾），随手写的随机串会直接报错。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 中台等外部系统凭证，必须与下面的上游 Key 分开保管，并单独做访问控制
CREDENTIAL_ENCRYPTION_KEY=
# 上游模型服务 API Key 的加密密钥
PROVIDER_ENCRYPTION_KEY=
# 轮换旧密钥：平时留空，换主密钥时才填（逗号分隔），重加密完成后清空
CREDENTIAL_ENCRYPTION_KEYS_OLD=
PROVIDER_ENCRYPTION_KEYS_OLD=

# Codex 渠道掉号巡检间隔（秒）。0 = 关闭巡检（只靠流量侧被动检测）
CODEX_HEALTH_INTERVAL_SECONDS=600

# ---- 上游模型渠道 ----
# 供 scripts/bootstrap.py 首次登记使用。Key 加密后入库，
# 之后改 Key 走后台「模型与白名单 → 上游渠道」，不必再动这里。
NEWAPI_BASE_URL=
NEWAPI_API_KEY=

# ---- 项目仓库（自建 Gitea）----
# Token 只放服务端部署环境，不下发客户端。建议只授予建仓所需的
# write:user,write:repository；Gitea 1.21 的 /user/repos 两者都要求。
GITEA_BASE_URL=
GITEA_API_TOKEN=
GITEA_REPO_OWNER=
GITEA_TIMEOUT_SECONDS=15

# ---- 发送方向脱敏兜底（决策 #9）----
# 逗号分隔的公司名/品牌关键词，出网前替换成 MASK_PLACEHOLDER。
# 定位是"聊胜于无的防御纵深"，主防线仍是与厂商签的书面数据协议。
MASK_KEYWORDS=
MASK_PLACEHOLDER=[公司]

# ---- 会话附件留存（决策 #8「含上传文件/图片记录」）----
# 多模态请求里的图片/文件会被抽出来单独落盘，会话原文里只留占位符
# （不这么做的话一张内联 base64 截图就能撑爆 conversation_logs 的正文列）。
AUDIT_STORAGE_PATH=./static/audit/
# 关掉只影响**文件本体**：文件名、大小、sha256 照样入库，
# 审计员仍能看到「他发过一个 3MB 的 xlsx」。合规上想缩小留存面时才关。
AUDIT_STORE_ATTACHMENT_BYTES=true
# 单文件上限（字节），超出只记元数据。默认 10MB。
# 约束来自内存不是磁盘：处理期间峰值约是文件本身的 3.5~4 倍
# （body 字节 + base64 字符串 + 解码后的原始字节 + 审计副本），
# 详见 config.py 里 audit_attachment_max_bytes 的注释。
AUDIT_ATTACHMENT_MAX_BYTES=10485760
# 编码后的整个 HTTP 请求上限，包含 base64 及所有附件；超出返回 413。
REQUEST_BODY_MAX_BYTES=33554432

# ---- 桌面端自有更新（阶段 5）----
# 更新清单的签名公钥（base64 的 32 字节 Ed25519 公钥）。
#
# 网关上**只有公钥，没有私钥**：私钥留在离线签名机上，发布时先在那里签好，
# 把「清单 + 签名」一起提交给发布接口，网关用这把公钥验一遍才准入库。
# 它因此验得了、签不出来 —— 网关被拿下也造不出客户端会接受的更新。
#
# 必须与客户端内置的那把是同一把（见 apps/desktop/product-environments.json 的
# updateSigningPublicKey）。不配的话发布接口会拒绝，而不是跳过校验直接入库 ——
# 现象是「版本发不上去」，不是「发上去了但客户端不认」。
UPDATE_PUBLIC_KEY=

# ---- CORS ----
# 生产环境允许的来源，逗号分隔；dev 环境放开全部。
# ⚠️ prod 下留空会回落到占位域名 https://your-domain.com（见 main.create_app），
# 表现是管理后台每个请求都跨域失败，而服务本身一切正常。
CORS_ALLOW_ORIGINS=

# ---- 静态文件 ----
AVATAR_PATH=./static/avatar/

# ---- 管理后台前端 ----
# 前端构建产物目录（client 下 npm run build 的输出）。留空按 ../client/dist 找。
# 配上之后网关自己发前端，不需要 nginx，也省掉一次跨域。
FRONTEND_DIST_PATH=
